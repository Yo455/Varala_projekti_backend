{
  "scripts": {
    "postinstall": "npm install --prefix calendar-api; npm install --prefix calendar-ui",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"green,blue\" \"npm run server\" \"npm run client\"",
    "server": "cd calendar-api && node index.js",
    "client": "cd calendar-ui && npm run dev"
  },
    "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
